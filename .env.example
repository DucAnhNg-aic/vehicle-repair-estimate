# Copy thành .env rồi điền giá trị: cp .env.example .env

# --- LLM providers ---
# Hai provider độc lập: gemini (GEMINI_API_KEY) và claude (ANTHROPIC_API_KEY).
# Mỗi job (demo, API, API đối tác) chọn một provider cho cả OCR và mapping; không chọn thì dùng LLM_PROVIDER.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash-lite      # Model mặc định khi job chọn gemini
GEMINI_MAPPING_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=                          # Để trống = tắt provider claude
CLAUDE_OCR_MODEL=claude-haiku-5-5           # Model mặc định khi job chọn claude
CLAUDE_MAPPING_MODEL=claude-haiku-5-5
# Cấu hình cũ OCR_MODEL/MAPPING_MODEL vẫn đọc được: áp cho provider trùng tiền tố tên model.
GEMINI_MODEL=gemini-3.8-flash               # Chỉ dùng cho luồng classification codebook

# Mức suy luận: LOW | MEDIUM | HIGH (Claude: effort, Gemini: thinking_level); để trống = mặc định của model
OCR_THINKING_LEVEL=MEDIUM
MAPPING_THINKING_LEVEL=MEDIUM

# --- MongoDB ---
# docker compose dùng MONGO_USERNAME/MONGO_PASSWORD để tạo user root và tự ghép MONGO_URI cho api/worker.
# MONGO_URI ở đây chỉ dùng khi chạy CLI/pipeline ngoài Docker.
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_URI=mongodb://<MONGO_USERNAME>:<MONGO_PASSWORD>@127.0.0.1:27017/?authSource=admin
MONGO_DATABASE=vehicle_repair_estimate
MONGO_COLLECTION=repair_estimates
# MONGO_INPUT_FILES_COLLECTION=input_files
# MONGO_CACHE_COLLECTION=llm_cache
# CACHE_TTL_DAYS=30

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Deploy ---
# IP của máy chủ mà nginx publish cổng 8000
IP_ADDRESS=

# --- API / demo ---
# Model cho phép chọn ở demo/API, cả hai provider (phân tách bằng dấu phẩy); phải chứa model mặc định
# của mọi provider được bật. Provider khác LLM_PROVIDER chỉ bật khi có API key VÀ có model trong danh sách này.
# Bỏ trống = model mặc định của các provider có key. Demo hiển thị tên ẩn hãng (vd. aicycle-1.5-swift-mini).
VRE_API_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,claude-haiku-5-5,claude-sonnet-5-5
# true: demo UI hiện chọn engine (AICycle 1.x = gemini, AICycle 5.x = claude), model và reasoning;
# false: ẩn, luôn dùng LLM_PROVIDER và model mặc định
VRE_API_SHOW_AI_OPTIONS=false
# VRE_API_WORKERS=10
# VRE_API_MAX_UPLOAD_BYTES=26214400
# Thư mục lưu file đầu vào theo sha256 (chỉ lưu khi save_mongodb=true); mặc định <project>/input_files
# VRE_INPUT_STORE_DIR=/app/input_files
# VRE_API_JOB_TIMEOUT_SECONDS=2100
# VRE_API_RESULT_TTL_SECONDS=604800
# Context cache của Gemini cho codebook mapping (Claude dùng prompt caching tự động, không cần cấu hình)
# MAPPING_CONTEXT_CACHE_ENABLED=true
# MAPPING_CONTEXT_CACHE_TTL_SECONDS=1800

# --- API đối tác (/partner/v1) ---
# Dạng ten:key, nhiều khách cách nhau bởi dấu phẩy; xoá entry để thu hồi. Để trống = tắt API đối tác.
VRE_PARTNER_API_KEYS=
VRE_PARTNER_MAX_WAIT_SECONDS=90
