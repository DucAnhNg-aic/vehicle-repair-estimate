# Copy thành .env rồi điền giá trị: cp .env.example .env

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash          # Chỉ dùng cho luồng classification
OCR_MODEL=gemini-3.8-flash             # Chỉ dùng cho luồng OCR
MAPPING_MODEL=gemini-3.5-flash-lite    # Chỉ dùng cho luồng mapping

# Reasoning (thinking) level: LOW | MEDIUM | HIGH
OCR_THINKING_LEVEL=MEDIUM
MAPPING_THINKING_LEVEL=HIGH

# --- MongoDB ---
# docker compose dùng MONGO_USERNAME/MONGO_PASSWORD để tạo user root và tự ghép MONGO_URI cho api/worker.
# MONGO_URI ở đây chỉ dùng khi chạy CLI/pipeline ngoài Docker.
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_URI=mongodb://<MONGO_USERNAME>:<MONGO_PASSWORD>@127.0.0.1:27017/?authSource=admin
MONGO_DATABASE=vehicle_repair_estimate
MONGO_COLLECTION=repair_estimates
# MONGO_CACHE_COLLECTION=llm_cache
# CACHE_TTL_DAYS=30

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Deploy ---
# IP của máy chủ mà nginx publish cổng 8000
IP_ADDRESS=

# --- API / demo ---
# Danh sách model hiển thị trong dropdown demo (phân tách bằng dấu phẩy); phải chứa OCR_MODEL và MAPPING_MODEL
VRE_API_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# true: hiện dropdown model/reasoning ở demo UI; false: ẩn (luôn dùng cấu hình Auto)
VRE_API_SHOW_AI_OPTIONS=false
# VRE_API_WORKERS=10
# VRE_API_MAX_UPLOAD_BYTES=26214400
# VRE_API_JOB_TIMEOUT_SECONDS=2100
# VRE_API_RESULT_TTL_SECONDS=604800
# MAPPING_CONTEXT_CACHE_ENABLED=true
# MAPPING_CONTEXT_CACHE_TTL_SECONDS=1800

# --- API đối tác (/partner/v1) ---
# Dạng ten:key, nhiều khách cách nhau bởi dấu phẩy; xoá entry để thu hồi. Để trống = tắt API đối tác.
VRE_PARTNER_API_KEYS=
VRE_PARTNER_MAX_WAIT_SECONDS=90
